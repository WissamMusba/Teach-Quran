rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Voice notes are owner-private: /audio_notes/{uid}/{fileId} is readable and
    // writable ONLY by that signed-in user's devices. The old flat
    // /audio_notes/{fileId} rule let ANY authenticated account read, overwrite or
    // delete every user's recordings.
    match /audio_notes/{userId}/{fileId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}

